@page "/ConfirmacionVisita"
@layout NoMenuLayout

@inject IGestionAccesosService GestionAccesosService
@inject AppNavigator Navigator
@inject TranslationService TranslationService
@inject ILocalStorageService LocalStorage
@inject EmailService EmailService
@inject IToastService ToastService

<PageTitle>@TranslationService["RegistroSalida"]</PageTitle>

<SplashScreen Visible="_isLoading"
              Title="@TranslationService["TituloSplash"]"
              Subtitle="@TranslationService["ConfirmandoVisita"]" />

@if (!_isLoading)
{
    <div class="confirmacion-page">
        <div class="confirmacion-card confirmacion-animada">
            <div class="confirmacion-icono">
                <span style="font-size:6rem;line-height:1;display:inline-block;animation:bounce-emoji 0.6s ease-out,pulse-emoji 2s ease-in-out 0.6s infinite">🤝</span>
            </div>

            <h1 class="confirmacion-titulo">
                @TranslationService["Bienvenido"]
            </h1>

            <p class="confirmacion-texto">
                <strong>@(personaAVisitar?.NombreCompleto ?? string.Empty)</strong>
                @TranslationService["EstaraEnUnMomento"]
            </p>

            <div class="confirmacion-id-badge">
                <span class="id-badge-label">@TranslationService["TuIdVisitante"]</span>
                <span class="id-badge-num">@visitante.IdVisitante</span>
                <span class="id-badge-hint">@TranslationService["GuardaloParaSalida"]</span>
            </div>

            <div class="confirmacion-barra">
                <div class="confirmacion-barra-progreso"></div>
            </div>
        </div>
    </div>
}

@code
{
    private bool _isLoading = true;
    private bool _navegacionProgramada = false;

    private VisitanteDTO visitante = new();
    private PersonasAvisitarDTO personaAVisitar = new();

    private bool _inicializado = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_inicializado)
        {
            _inicializado = true;
            _isLoading = true;
            StateHasChanged();

            try
            {
                await IdiomaHelper.CargarIdiomaAsync(LocalStorage, TranslationService);

                visitante = await LocalStorage.GetItemAsync<VisitanteDTO>("visitante") ?? new VisitanteDTO();
                personaAVisitar = await LocalStorage.GetItemAsync<PersonasAvisitarDTO>("personaAVisitar") ?? new PersonasAvisitarDTO();

                if (visitante == null || visitante.IdVisitante == 0)
                {
                    try { ToastService.MostrarError(TranslationService["NoSeHaEncontradoElVisitante"]); } catch { }
                    return;
                }

                if (personaAVisitar == null || personaAVisitar.IdPersona == 0)
                {
                    try { ToastService.MostrarError(TranslationService["NoSeHaEncontradoElVisitante"]); } catch { }
                    return;
                }

                var visita = new VisitaDTO
                {
                    IdVisitante = visitante.IdVisitante,
                    IdPersona = personaAVisitar.IdPersona,
                    FechaEntrada = DateTime.Now,
                    FechaRegistro = DateTime.Now,
                    Borrado = false
                };

                var result = await GestionAccesosService.TratarVisita(visita);

                if (result != null && result.Errors.Count == 0)
                {
                    string nombreVisitante = $"{visitante.Nombre} {visitante.PrimerApellido}".Trim();
                    string nombrePersona = personaAVisitar.NombreCompleto ?? string.Empty;

                    var hora = DateTime.Now.ToString("HH:mm");
                    var fecha = DateTime.Now.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));
                    var primerNombre = nombrePersona.Split(' ')[0];

                    string asunto = $"🧑‍💼 {nombreVisitante} ha llegado a recepción";
                    string cuerpo = $"""
                        <table width="100%" cellpadding="0" cellspacing="0" style="font-family:sans-serif;max-width:520px;margin:0 auto;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;background:#ffffff">
                          <tr>
                            <td style="background:#a91c32;padding:16px 20px">
                              <table cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                  <td width="48" style="vertical-align:middle">
                                    <div style="background:rgba(255,255,255,.18);border-radius:10px;width:42px;height:42px;text-align:center;line-height:42px;font-size:22px">🧑‍💼</div>
                                  </td>
                                  <td style="padding-left:12px;vertical-align:middle">
                                    <div style="color:#ffffff;font-weight:700;font-size:1rem;margin:0">Tienes una visita esperándote</div>
                                    <div style="color:rgba(255,255,255,.75);font-size:.8rem;margin-top:3px">Recepción · hoy a las {hora}</div>
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                          <tr>
                            <td style="padding:20px">
                              <p style="color:#1e293b;margin:0 0 16px;font-size:.95rem">Hola <strong>{primerNombre}</strong>, tu visita ha llegado a recepción y te está esperando.</p>
                              <table cellpadding="0" cellspacing="0" width="100%" style="background:#f8fafc;border-radius:10px;margin-bottom:16px">
                                <tr>
                                  <td style="padding:12px 16px;width:50%;vertical-align:top">
                                    <div style="color:#94a3b8;font-size:.72rem;margin-bottom:3px">Visitante</div>
                                    <div style="color:#1e293b;font-weight:600;font-size:.92rem">{nombreVisitante}</div>
                                  </td>
                                  <td style="padding:12px 16px;width:50%;vertical-align:top">
                                    <div style="color:#94a3b8;font-size:.72rem;margin-bottom:3px">Hora de llegada</div>
                                    <div style="color:#1e293b;font-weight:600;font-size:.92rem">{hora}</div>
                                  </td>
                                </tr>
                                <tr>
                                  <td style="padding:12px 16px;width:50%;vertical-align:top;border-top:1px solid #e2e8f0">
                                    <div style="color:#94a3b8;font-size:.72rem;margin-bottom:3px">Fecha</div>
                                    <div style="color:#1e293b;font-weight:600;font-size:.92rem">{fecha}</div>
                                  </td>
                                  <td style="padding:12px 16px;width:50%;vertical-align:top;border-top:1px solid #e2e8f0">
                                    <div style="color:#94a3b8;font-size:.72rem;margin-bottom:3px">Ubicación</div>
                                    <div style="color:#1e293b;font-weight:600;font-size:.92rem">Recepción</div>
                                  </td>
                                </tr>
                              </table>
                              <table cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                  <td style="color:#94a3b8;font-size:.72rem;padding-top:10px;border-top:1px solid #f1f5f9">· Gestión de Accesos</td>
                                  <td style="color:#94a3b8;font-size:.72rem;text-align:right;padding-top:10px;border-top:1px solid #f1f5f9">Notificación automática</td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>
                        """;

                    if (!string.IsNullOrWhiteSpace(personaAVisitar.Correo))
                    {
                        try
                        {
                            await EmailService.SendEmailAsync(
                                personaAVisitar.Correo,
                                asunto,
                                cuerpo,
                                MessagePriority.Normal
                            );
                        }
                        catch { }
                    }

                    try { ToastService.MostrarOk(TranslationService["VisitaConfirmadaConExito"]); } catch { }
                }
                else
                {
                    try { ToastService.MostrarError(TranslationService["HuboUnErrorAlConfirmarLaVisita"]); } catch { }
                }
            }
            catch (Exception ex)
            {
                try { ToastService.MostrarError($"Error inesperado: {ex.Message}"); } catch { }
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }

            return;
        }

        if (!_isLoading && !_navegacionProgramada)
        {
            _navegacionProgramada = true;
            await Task.Delay(5000);
            await LocalStorage.RemoveItemAsync("visitante");
            await LocalStorage.RemoveItemAsync("personaAVisitar");
            Navigator.NavigateTo("/", true);
        }
    }
}