@page "/GestionGeneralEtt"
@attribute [Authorize(Roles = "Administrador,RRHH,Visitas")]
@implements IDisposable

@using System.Collections.ObjectModel

@inject IGestionAccesosService GestionAccesosService
@inject IToastService ToastService
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

@if (_isLoading)
{
    <div class="page-loader">
        <div class="loader-card">
            <div class="loader-spinner"></div>
            <span>Cargando datos...</span>
        </div>
    </div>
}

<div class="admin-home-page">

    <section class="admin-hero">
        <div>
            <span class="admin-kicker">PANEL DE CONTROL</span>
            <h1>Bienvenido/a</h1>
            <p>Resumen del estado actual de visitas y trabajadores.</p>
        </div>
        <div class="admin-date-block">
            <span class="admin-time">@_horaActual</span>
            <span class="admin-date">@DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
        </div>
    </section>

    @* ===== KPIs ===== *@
    <section class="kpi-grid">
        <div class="kpi-card kpi-checkin">
            <div class="kpi-icon"><i class="bi bi-person-check"></i></div>
            <div class="kpi-info">
                <span>Visitas activas hoy</span>
                <strong>@_visitasActivas</strong>
            </div>
        </div>

        <div class="kpi-card kpi-checkout">
            <div class="kpi-icon"><i class="bi bi-person-dash"></i></div>
            <div class="kpi-info">
                <span>Visitas finalizadas hoy</span>
                <strong>@_visitasFinalizadas</strong>
            </div>
        </div>

        <div class="kpi-card kpi-working">
            <div class="kpi-icon"><i class="bi bi-briefcase"></i></div>
            <div class="kpi-info">
                <span>Trabajadores activos</span>
                <strong>@_trabajadoresActivos</strong>
            </div>
        </div>

        <div class="kpi-card kpi-total">
            <div class="kpi-icon"><i class="bi bi-person-vcard"></i></div>
            <div class="kpi-info">
                <span>Personas a visitar</span>
                <strong>@_personasAVisitar</strong>
            </div>
        </div>
    </section>

    @* ===== GRÁFICA + TRABAJADORES ===== *@
    <section class="charts-grid">
        <div class="chart-card chart-bar">
            <div class="chart-header">
                <h2>Visitas últimos 7 días</h2>
                <p>Número de visitas por día</p>
            </div>
            <div class="chart-body">
                <canvas id="chartVisitas"></canvas>
            </div>
        </div>

        <div class="widget-card">
            <div class="widget-header">
                <div>
                    <h2>Trabajadores en planta</h2>
                    <p>@(_trabajadoresList.Any() ? $"{_trabajadoresActivos} en la instalación ahora" : "Presencia en tiempo real")</p>
                </div>
                @if (_trabajadoresList.Any())
                {
                    <span class="widget-badge">Ahora</span>
                }
            </div>
            <div class="widget-list">
                @if (!_trabajadoresList.Any())
                {
                    <div class="empty-planta">
                        <i class="bi bi-buildings"></i>
                        <strong>Nadie en planta ahora mismo</strong>
                        <span>El primer fichaje del día aparecerá aquí</span>
                    </div>
                }
                else
                {
                    @foreach (var f in _trabajadoresList.Take(6))
                    {
                        var nombre = f.NombreCompleto;
                        var departamento = f.Departamento ?? "Sin departamento";
                        var iniciales = GetInitialsFromFullName(nombre);
                        var esNuevo = _newWorkerIds.Contains(f.IdFichaje);
                        <div class="worker-row @(esNuevo ? "worker-row--new" : "")">
                            <div class="worker-avatar-sm" style="background:@GetAvatarColor(nombre)">
                                @iniciales
                            </div>
                            <div class="worker-info">
                                <strong>@nombre</strong>
                                <small>@departamento</small>
                            </div>
                            <span class="worker-status status-ok">@(f.HoraEntrada?.ToString("HH:mm") ?? "-")</span>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    @* ===== TRABAJADORES POR ETT ===== *@
    @if (_trabajadoresPorEtt.Any())
    {
        <section class="ett-grid-card">
            <div class="ett-grid-header">
                <div>
                    <h2>Trabajadores por ETT</h2>
                    <p>Distribución de trabajadores vigentes por empresa de trabajo temporal</p>
                </div>
                <span class="widget-badge">@_trabajadoresPorEtt.Values.Sum() total</span>
            </div>
            <div class="ett-bars">
                @{ var maxEtt = _trabajadoresPorEtt.Values.Max(); }
                @foreach (var (empresa, count) in _trabajadoresPorEtt.OrderByDescending(e => e.Value))
                {
                    var pct = maxEtt > 0 ? (count * 100 / maxEtt) : 0;
                    var porcentajeTotal = _trabajadoresPorEtt.Values.Sum() > 0
                        ? (count * 100 / _trabajadoresPorEtt.Values.Sum())
                        : 0;
                    <div class="ett-bar-row">
                        <span class="ett-bar-label">@empresa</span>
                        <div class="ett-bar-track">
                            <div class="ett-bar-fill" style="width:@pct%"></div>
                        </div>
                        <span class="ett-bar-count">@count</span>
                        <span class="ett-bar-pct">@porcentajeTotal%</span>
                    </div>
                }
            </div>
        </section>
    }

    @* ===== NOTIFICACIONES ===== *@
    <section class="notif-card">
        <div class="notif-header">
            <div>
                <h2><i class="bi bi-bell"></i> Notificaciones</h2>
                <p>Recordatorios y alertas del sistema</p>
            </div>
        </div>
        <div class="notif-list">
            @if (!_notificaciones.Any())
            {
                <div class="notif-empty">
                    <i class="bi bi-check-circle text-success"></i>
                    <span>Sin notificaciones pendientes</span>
                </div>
            }
            else
            {
                @foreach (var n in _notificaciones)
                {
                    <div class="notif-item notif-@n.Tipo">
                        <div class="notif-dot"></div>
                        <div class="notif-content">
                            <span class="notif-title">@n.Titulo</span>
                            <span class="notif-desc">@n.Descripcion</span>
                        </div>
                        <span class="notif-badge">@n.Badge</span>
                    </div>
                }
            }
        </div>
    </section>

    @* ===== ÚLTIMAS VISITAS HOY ===== *@
    <section class="recent-card">
        <div class="recent-header">
            <div>
                <h2>Visitas de hoy</h2>
                <p>@_visitasHoy.Count @(_visitasHoy.Count == 1 ? "visita registrada" : "visitas registradas")</p>
            </div>
        </div>

        @if (!_visitasHoy.Any())
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <strong>No hay visitas registradas hoy</strong>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="recent-table">
                    <thead>
                        <tr>
                            <th>Estado</th>
                            <th>Visitante</th>
                            <th>Anfitrión</th>
                            <th>Empresa</th>
                            <th>Entrada</th>
                            <th>Salida</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _visitasHoy)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(v.Estado == "Checked-in" ? "badge-in" : "badge-out")">
                                        @v.Estado
                                    </span>
                                </td>
                                <td class="strong-cell">@v.NombreCompletoVisitante</td>
                                <td>@v.NombreCompletoAnfitrion</td>
                                <td>@(v.EmpresaVisitante ?? "-")</td>
                                <td>@v.FechaEntrada.ToString("HH:mm")</td>
                                <td>@(v.FechaSalida.HasValue ? v.FechaSalida.Value.ToString("HH:mm") : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>

@code {
    private bool _isLoading;
    private string _horaActual = DateTime.Now.ToString("HH:mm:ss");
    private System.Threading.Timer? _timer;
    private int _refreshCounter = 0;

    private int _visitasActivas;
    private int _visitasFinalizadas;
    private int _trabajadoresActivos;
    private int _personasAVisitar;

    private List<VisitaDTO> _visitasHoy = new();
    private List<FichajesTrabajadorDTO> _trabajadoresList = new();
    private Dictionary<string, int> _trabajadoresPorEtt = new();
    private List<NotificacionItem> _notificaciones = new();
    private HashSet<int> _newWorkerIds = new();
    private HashSet<int> _previousWorkerIds = new();

    private record NotificacionItem(string Tipo, string Titulo, string Descripcion, string Badge);

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                _horaActual = DateTime.Now.ToString("HH:mm:ss");

                _refreshCounter++;
                if (_refreshCounter >= 30)
                {
                    _refreshCounter = 0;
                    await Task.WhenAll(CargarVisitas(), CargarTrabajadores());
                }

                StateHasChanged();
            });
        }, null, 0, 1000);

        try
        {
            await Task.WhenAll(
                CargarVisitas(),
                CargarTrabajadores(),
                CargarPersonasAVisitar(),
                CargarTrabajadoresPorEtt(),
                CargarNotificaciones()
            );
        }
        catch (Exception ex)
        {
            ToastService.MostrarError($"Error al cargar el dashboard: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RenderizarGraficas();
    }

    private async Task CargarVisitas()
    {
        var hoy = await GestionAccesosService.GetVisitasHoy();
        if (hoy?.Data != null)
        {
            _visitasHoy = hoy.Data;
            _visitasActivas = hoy.Data.Count(v => v.Estado == "Checked-in");
            _visitasFinalizadas = hoy.Data.Count(v => v.Estado == "Checked-out");
            StateHasChanged();
        }
    }

    private async Task CargarTrabajadores()
    {
        var result = await GestionAccesosService.GetAllFichajes(soloAbiertos: true);
        if (result?.Data != null)
        {
            var nuevosIds = result.Data.Select(f => f.IdFichaje).ToHashSet();
            var recienLlegados = nuevosIds.Except(_previousWorkerIds).ToHashSet();

            _trabajadoresList = result.Data;
            _trabajadoresActivos = result.Data.Count;

            if (recienLlegados.Any() && _previousWorkerIds.Any())
            {
                _newWorkerIds = recienLlegados;
                StateHasChanged();

                _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
                {
                    _newWorkerIds.Clear();
                    StateHasChanged();
                }));
            }

            _previousWorkerIds = nuevosIds;
        }
    }

    private async Task CargarNotificaciones()
    {
        _notificaciones.Clear();
        var hoy = DateTime.Today;

        var trabajadores = await GestionAccesosService.GetAllTrabajadores();
        if (trabajadores?.Data != null)
        {
            foreach (var t in trabajadores.Data.Where(t => !t.Borrado && t.FechaMaximaTemporalidad.HasValue))
            {
                var dias = (t.FechaMaximaTemporalidad!.Value.Date - hoy).Days;
                if (dias < 0) continue;
                var tipo = dias <= 7 ? "danger" : dias <= 15 ? "warn" : dias <= 30 ? "info" : null;
                if (tipo == null) continue;
                _notificaciones.Add(new NotificacionItem(
                    tipo,
                    $"Contrato próximo a vencer — {t.Nombre}",
                    $"Fecha máxima de temporalidad: {t.FechaMaximaTemporalidad.Value:dd/MM/yyyy}",
                    dias == 0 ? "Hoy" : $"{dias}d"
                ));
            }
        }

        _notificaciones = _notificaciones.OrderBy(n => n.Tipo == "danger" ? 0 : n.Tipo == "warn" ? 1 : 2).ToList();
    }

    private async Task CargarTrabajadoresPorEtt()
    {
        var result = await GestionAccesosService.GetAllTrabajadores();
        if (result?.Data != null)
        {
            _trabajadoresPorEtt = result.Data
                .Where(t => !t.Borrado && !string.IsNullOrWhiteSpace(t.NombreETT))
                .GroupBy(t => t.NombreETT)
                .ToDictionary(g => g.Key, g => g.Count());
        }
    }

    private async Task CargarPersonasAVisitar()
    {
        var result = await GestionAccesosService.GetAllPersonasAVisitar();
        if (result?.Data != null)
            _personasAVisitar = result.Data.Count(p => !p.Borrado);
    }

    private async Task RenderizarGraficas()
    {
        var labels = new List<string>();
        var datos = new List<int>();

        for (var i = 6; i >= 0; i--)
        {
            var dia = DateTime.Today.AddDays(-i);
            labels.Add(dia.ToString("ddd d", new System.Globalization.CultureInfo("es-ES")));
            var result = await GestionAccesosService.GetVisitasByDateRange(dia, dia.AddDays(1).AddSeconds(-1));
            datos.Add(result?.Data?.Count ?? 0);
        }

        await JS.InvokeVoidAsync("renderBarChart", "chartVisitas", labels, datos, "Visitas");
    }

    private static string GetInitialsFromFullName(string? nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "?";
        var parts = nombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }

    private static string GetAvatarColor(string? nombre)
    {
        var colors = new[] { "#a91c32", "#2563eb", "#16a34a", "#ca8a04", "#7c3aed", "#0891b2" };
        var idx = string.IsNullOrWhiteSpace(nombre) ? 0 : Math.Abs(nombre[0] % colors.Length);
        return colors[idx];
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
