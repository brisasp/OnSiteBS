@page "/login"
@layout NoMenuLayout
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Antiforgery
@inject NavigationManager Navigation
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-overlay"></div>

    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <img src="Images/logo.svg" alt="Logo" class="logo-login" />
                <h1 class="login-title">Iniciar sesión</h1>
                <p class="login-subtitle">Accede a la plataforma de gestión de accesos</p>
            </div>

            @if (showLogoutMessage)
            {
                <div class="login-alert login-alert-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Sesión cerrada correctamente.</span>
                    <button type="button" class="alert-close" @onclick="() => showLogoutMessage = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="login-alert login-alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@error</span>
                    <button type="button" class="alert-close" @onclick="() => error = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            <form class="login-form" method="post" action="/auth/login" data-enhance="false">
                <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
                <div class="form-group">
                    <label class="form-label">Usuario</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-person input-icon"></i>
                        <input class="login-input"
                               name="NombreUsuario"
                               placeholder="Usuario"
                               @bind="model.NombreUsuario"
                               @bind:event="oninput"
                               @ref="usuarioInput" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Contraseña</label>
                    <div class="input-icon-wrapper password-wrapper">
                        <i class="bi bi-key input-icon"></i>
                        <input class="login-input login-input-password"
                               name="Contraseña"
                               type="@(mostrarPassword ? "text" : "password")"
                               placeholder="Contraseña"
                               @bind="model.Contraseña"
                               @bind:event="oninput" />
                        <button type="button"
                                class="password-toggle-btn"
                                @onclick="TogglePassword"
                                aria-label="Mostrar u ocultar contraseña">
                            <i class="bi @(mostrarPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <div class="login-options">
                    <label class="remember-custom">
                        <input type="checkbox" name="Recordarme" @bind="model.Recordarme" />
                        <span class="checkmark"></span>
                        <span class="remember-text">Recordar sesión durante 7 días</span>
                    </label>
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Iniciar sesión</span>
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    private LoginRequestDTO model = new();
    private string? error;
    private bool showLogoutMessage;
    private bool mostrarPassword;
    private ElementReference usuarioInput;
    private string? antiforgeryToken;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;

        if (httpContext != null)
        {
            antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext).RequestToken;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("logout", out var logoutValue) && logoutValue == "1")
            showLogoutMessage = true;

        if (query.TryGetValue("error", out var errorValue))
        {
            error = errorValue.ToString() switch
            {
                "usuario" => "Usuario no encontrado.",
                "credenciales" => "Credenciales incorrectas.",
                "rol" => "No tienes permisos para acceder al sistema.",
                _ => "Se ha producido un error inesperado."
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await usuarioInput.FocusAsync();
        }
    }

    private void TogglePassword()
    {
        mostrarPassword = !mostrarPassword;
    }

