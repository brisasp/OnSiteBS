@page "/SeleccionarVisita"
@layout NoMenuLayout

@inject IToastService ToastService
@inject IJSRuntime jsRuntime
@inject IGestionAccesosService GestionAccesosService
@inject AppNavigator Navigator
@inject ILocalStorageService LocalStorage
@inject TranslationService TranslationService
@inject ILogger<SeleccionarVisita> Logger

<PageTitle>@TranslationService["AQuienDeseaVisitar"]</PageTitle>

@if (_isLoading)
{
    <div class="loading-overlay">
        <div class="loading-box">
            <div class="spinner-border text-danger" role="status"></div>
            <div class="mt-3">@TranslationService["Cargando"]</div>
        </div>
    </div>
}

<div class="acceso-visitas-page">
    <div class="acceso-visitas-box">
        <h1 class="acceso-titulo">@TranslationService["AQuienDeseaVisitar"]</h1>

        <div class="acceso-buscador">
            <input class="acceso-input"
                   placeholder="@TranslationService["AQuienDeseaVisitar"]"
                   @bind="Text"
                   @bind:event="oninput" />

            @if (personasFiltradas.Any())
            {
                <div class="visitantes-dropdown">
                    @foreach (var persona in personasFiltradas)
                    {
                        <button type="button"
                                class="visitante-item"
                                @onclick="() => SeleccionarPersona(persona)">
                            <img src="@ImagenHelper.ObtenerFotoBase64(persona.Foto)"
                                 alt="Foto"
                                 class="visitante-foto" />
                            <div class="visitante-info">
                                <div class="visitante-nombre">@persona.NombreCompleto</div>
                                <div class="visitante-correo">@persona.Correo</div>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="acciones">
            <button class="kiosk-btn" @onclick="HandleContinue">
                @TranslationService["Continuar"]
            </button>
        </div>
    </div>
</div>

@code {
    private bool _isLoading;
    private List<PersonasAvisitarDTO> personasAVisitar { get; set; } = new();
    private PersonasAvisitarDTO? personaSeleccionada;
    private string Text { get; set; } = string.Empty;

    private IEnumerable<PersonasAvisitarDTO> personasFiltradas =>
        string.IsNullOrWhiteSpace(Text)
            ? Enumerable.Empty<PersonasAvisitarDTO>()
            : personasAVisitar
                .Where(p =>
                    (!string.IsNullOrWhiteSpace(p.NombreCompleto) &&
                     p.NombreCompleto.Contains(Text, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(p.Correo) &&
                     p.Correo.Contains(Text, StringComparison.OrdinalIgnoreCase)))
                .Take(8);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _isLoading = true;
        StateHasChanged();

        await IdiomaHelper.CargarIdiomaAsync(LocalStorage, TranslationService);

        var result = await GestionAccesosService.GetAllPersonasAVisitar();

        if (result?.Data != null)
        {
            personasAVisitar = result.Data;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task SeleccionarPersona(PersonasAvisitarDTO selectedPersona)
    {
        try
        {
            personaSeleccionada = selectedPersona;
            Text = selectedPersona.NombreCompleto;

            // No guardamos la foto en localStorage para evitar superar el límite de SignalR
            var personaSinFoto = new PersonasAvisitarDTO
            {
                IdPersona = selectedPersona.IdPersona,
                NombreCompleto = selectedPersona.NombreCompleto,
                Correo = selectedPersona.Correo,
                Departamento = selectedPersona.Departamento,
                Foto = null,
                FechaRegistro = selectedPersona.FechaRegistro,
                Borrado = selectedPersona.Borrado
            };

            await LocalStorage.RemoveItemAsync("personaAVisitar");
            await LocalStorage.SetItemAsync("personaAVisitar", personaSinFoto);

            Navigator.NavigateTo("/ConfirmacionVisita");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en SeleccionarPersona");
            ToastService.MostrarError(TranslationService["ErrorSeleccionarPersona"]);
        }
    }

    private async Task HandleContinue()
    {
        try
        {
            if (personaSeleccionada == null)
            {
                ToastService.MostrarError(TranslationService["SeleccionaPersonaParaContinuar"]);
                return;
            }

            var personaSinFoto = new PersonasAvisitarDTO
            {
                IdPersona = personaSeleccionada.IdPersona,
                NombreCompleto = personaSeleccionada.NombreCompleto,
                Correo = personaSeleccionada.Correo,
                Departamento = personaSeleccionada.Departamento,
                Foto = null,
                FechaRegistro = personaSeleccionada.FechaRegistro,
                Borrado = personaSeleccionada.Borrado
            };

            await LocalStorage.RemoveItemAsync("personaAVisitar");
            await LocalStorage.SetItemAsync("personaAVisitar", personaSinFoto);

            Navigator.NavigateTo("/ConfirmacionVisita");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en HandleContinue");
            ToastService.MostrarError(TranslationService["ErrorAlContinuar"]);
        }
    }
}